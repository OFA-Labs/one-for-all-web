# Public frontend integration settings are below; never put provider secrets here.
# Optional, tooling only (scripts/review.mjs): base URL to screenshot.
ONE_FOR_ALL_PREVIEW_URL=

NEXT_PUBLIC_EBRAIN_API_URL=
NEXT_PUBLIC_EBRAIN_TOKEN=
# Desktop companion (public configuration only; no speech/provider credentials)
NEXT_PUBLIC_OFA_COMPANION_URL=http://127.0.0.1:8767
# Set only after a real Windows download has been published.
NEXT_PUBLIC_OFA_COMPANION_DOWNLOAD_URL=

# History live mode (optional). Leave all three unset for the offline preview.
# HISTORY_API_URL / HISTORY_API_TOKEN are SERVER-ONLY: never prefix them NEXT_PUBLIC_.
# NEXT_PUBLIC_HISTORY_API_URL only switches live mode on; it must be /api/history.
HISTORY_API_URL=
HISTORY_API_TOKEN=
NEXT_PUBLIC_HISTORY_API_URL=
